PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# dummy key 
OPENAI_API_KEY=lm-studio-local

# model names
CHAT_MODEL=qwen2.5-7b-instruct-1m
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---------- App settings ----------
DOCS_DIR=data/docs
INDEX_DIR=data/index
SESSIONS_DIR=data/sessions

# Retrieval defaults
TOP_K=5
CHUNK_TOKENS=800
CHUNK_OVERLAP=120
